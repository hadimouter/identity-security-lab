# Copier ce fichier vers .env avant de demarrer le lab :
#
#   cp .env.example .env
#
# .env ne doit jamais etre commite, il est exclu par .gitignore.
#
# Toutes les valeurs ci-dessous sont des valeurs de demonstration
# locales. Elles ne doivent jamais etre reutilisees ailleurs.


# --- PostgreSQL -----------------------------------------------------
# Utilisateur proprietaire des deux bases du lab.
# Utilise par Keycloak et par l'API pour se connecter.
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab_local_dev_only
POSTGRES_PORT=5432


# --- Keycloak -------------------------------------------------------
# Compte administrateur de la console : http://localhost:8080
# Cree au tout premier demarrage du conteneur uniquement.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_dev_only
KEYCLOAK_PORT=8080


# --- API Express (phase 2D) -----------------------------------------
DATABASE_URL=postgresql://lab:lab_local_dev_only@localhost:5432/identitylab?schema=public
API_PORT=4000
# Audience attendue dans l'access token recu par l'API.
# Configuree dans Keycloak en phase 2B.
KEYCLOAK_AUDIENCE=identity-lab-api


# --- Frontend Next.js (phase 2C) ------------------------------------
KEYCLOAK_ISSUER=http://localhost:8080/realms/identity-lab
KEYCLOAK_CLIENT_ID=identity-lab-web
# Genere par Keycloak en phase 2B, onglet Credentials du client.
KEYCLOAK_CLIENT_SECRET=a-remplir-en-phase-2b
# Secret de chiffrement des sessions.
# Generer avec : openssl rand -base64 32
AUTH_SECRET=a-generer-avec-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
API_URL=http://localhost:4000


# --- Comptes de demonstration (phase 2B) ----------------------------
# Mots de passe des utilisateurs crees dans Keycloak.
DEMO_USER_PASSWORD=user_local_dev_only
DEMO_MANAGER_PASSWORD=manager_local_dev_only
DEMO_ADMIN_PASSWORD=admin_local_dev_only
