    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
